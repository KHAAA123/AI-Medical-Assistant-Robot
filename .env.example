# Copy to .env and fill in. Never commit .env.

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=
GEMINI_LIVE_VOICE=

# Web app (keep 127.0.0.1 on the kiosk; robot-control APIs are not authenticated)
ROBOT_APP_HOST=127.0.0.1
ROBOT_APP_PORT=8000

# Doctor area login (checked on the server)
DOCTOR_USERNAME=doctor
DOCTOR_PASSWORD=

# Arduino (medicine trays and doors)
ARDUINO_PORT=/dev/ttyACM0
ARDUINO_TIMEOUT_MS=30000

# Pharmacity product chatbot
PHARMACITY_CHATBOT_HOST=127.0.0.1
PHARMACITY_CHATBOT_PORT=8010
